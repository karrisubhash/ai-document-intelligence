.env
*.pyc
__pycache__/
venv/
.venv/
db.sqlite3
media/
staticfiles/
.pytest_cache/
.coverage
htmlcov/

# ML datasets, model artifacts and training runs - reproduced from
# configs and manifests, never committed.
ai/classification/data/
ai/classification/artifacts/
ai/classification/runs/

# Database dumps. Never committed: they contain every document.
backups/

# Resolved from a benchmark TEMPLATE by `manage.py seed_evaluation`. The
# document ids inside are specific to one database, so these are build
# artifacts - the TEMPLATE and the BASELINE are what is governed and
# reviewed.
#
# The glob, not just benchmark.json: benchmark-v2.json was written next to
# it and was NOT ignored, so a resolved artifact full of one laptop's
# primary keys was one `git add` away from being committed as if it were
# the governed dataset.
evaluation/benchmark.json
evaluation/benchmark-*.json
!evaluation/benchmark-*.template.json

# Written by `manage.py ingest_corpus`, keyed by database document id, for
# the same reason.
evaluation/corpus_manifest.json

# Written by the rollback procedure (docs/release/staging-runbook.md, step 18)
.release-previous
