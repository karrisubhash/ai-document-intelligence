DJANGO_DEBUG=True
# Required when DJANGO_DEBUG is not true - startup fails without it, and
# fails on this placeholder too. Generate a real one for any deployment.
DJANGO_SECRET_KEY=change-me
# Comma-separated hostnames this deployment answers on.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=ai_document_intelligence
POSTGRES_USER=app_user
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

REDIS_HOST=redis
REDIS_PORT=6379

CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

APP_PORT=8000

# --- Frontend console --------------------------------------------------
# Origins allowed to call this API cross-origin. Empty means same-origin
# only, which is the right production default; in DEBUG the Vite dev
# server's origin is allowed automatically, so this only needs setting
# when the console runs somewhere else.
# CORS_ALLOWED_ORIGINS=http://localhost:5173

# Host port the frontend dev server binds to when run under Docker
# (`docker compose --profile frontend up`).
FRONTEND_PORT=5173

# --- Document classification (optional) -------------------------------
# Empty means the CLASSIFICATION pipeline stage records SKIPPED - it never
# guesses a label. To enable the trained text baseline:
#   1. Train an artifact:  python -m ai.classification.training.train_text
#   2. Build with the ML layer:  INSTALL_ML=true docker compose up --build
#   3. Uncomment the line below.
# The artifact path needs no configuration - docker-compose mounts
# ai/classification/artifacts/ where the setting's default already looks.
# DOCUMENT_CLASSIFIER=documents.processing.classification.text_classifier.TextDocumentClassifier
INSTALL_ML=false

# Bakes the Anthropic SDK and boto3 into the image, which all three
# Bedrock-backed components need. See the Bedrock section below.
#   INSTALL_LLM=true docker compose up --build
INSTALL_LLM=false

# --- Structure and planning (phase 12) --------------------------------
# Both detectors default ON and are listed here only to switch them off.
# They are the two pluggable capabilities with nothing to configure: one
# reads tables out of page text that has already been extracted, the other
# reads the image dictionary a PDF already carries. Neither needs a model,
# an artifact or a download.
#
# Setting either to empty makes that half of LAYOUT_ANALYSIS record SKIPPED.
# DOCUMENT_TABLE_DETECTOR=
# DOCUMENT_FIGURE_DETECTOR=
#
# How many parts a multi-part question may be planned into. 1 disables
# planning entirely. Each step is a full retrieval, so this is a bound.
# RAG_MAX_PLAN_STEPS=4

# --- Amazon Bedrock: the three real AI components ---------------------
# One AWS account replaces all three bundled baselines. Until these are
# set the platform still works, and still says what it is doing: retrieval
# is lexical-only, and answers are verbatim quotes rather than prose.
#
#   embeddings  hashing baseline (semantic=False)  ->  Titan Text Embeddings V2
#   reranking   lexical word overlap               ->  Cohere Rerank 3.5
#   answering   verbatim sentence extraction       ->  Claude Opus 5
#
# PREREQUISITES, in this order:
#   1. pip install -r backend/requirements-llm.txt   (or INSTALL_LLM=true)
#   2. AWS credentials on the machine. The SDK reads ~/.aws/credentials,
#      an instance role, or AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY from
#      the environment. Do NOT put secrets in this file - it is committed.
#      A console username and password will not work; Bedrock needs an
#      access key, an SSO profile or a role.
#   3. Bedrock console -> Model access -> request access to Anthropic
#      Claude, Amazon Titan Embeddings and Cohere Rerank, IN THE REGION
#      BELOW. Access is per-region, and a model you have not been granted
#      returns a 404 that reads like the model does not exist.
#
# Required for every Bedrock call. No default: a silent us-east-1 would
# send traffic to a region the account may have no model access in.
# AWS_BEDROCK_REGION=us-east-1

# Semantic embeddings. The single highest-impact setting here: the hashing
# baseline treats "car" and "automobile" as orthogonal, which is survivable
# across five documents and is not across twelve thousand.
#
# SWITCHING THIS INVALIDATES EVERY STORED VECTOR. A vector is only
# comparable to another from the same model, so the migration and a full
# re-index are part of the change, not follow-up tidying:
#   1. write that migration first - the repository has none: change
#      EMBEDDING_DIMENSIONS in documents/models/chunk.py to 1024 (or 512/256)
#      and alter the embedding column and its HNSW index to match;
#   2. python manage.py migrate
#   3. python manage.py reindex       # re-embeds every chunk
# As shipped the column is 384 wide, which Titan cannot produce, and the
# Bedrock provider refuses to load until it is migrated.
# DOCUMENT_EMBEDDING_PROVIDER=documents.processing.embedding.bedrock.BedrockTitanEmbeddingProvider
# EMBEDDING_BEDROCK_CONCURRENCY=8     # Titan embeds one text per call

# Cross-encoder reranking. Reads query and passage together, so it scores
# whether a passage ANSWERS the question rather than whether it repeats its
# words - the largest precision gain available once hybrid retrieval exists.
# RAG_RERANKER=documents.rag.bedrock_rerank.BedrockReranker

# Generative answering. The guardrails do not move: permission filter still
# runs first, every claim still needs a resolvable citation, every figure
# is still checked against the passages, and a failure is still downgraded
# to an abstention.
# RAG_ANSWERER=documents.rag.claude.ClaudeAnswerer
# RAG_ANSWERER_BACKEND=bedrock
# RAG_ANSWERER_MODEL=claude-opus-5    # the "anthropic." prefix is added for you
# RAG_ANSWERER_EFFORT=medium
# A hosted answerer runs inside the chat request. One call can take
# TIMEOUT x (RETRIES + 1) seconds, and nginx gives up at 120 s - keep the
# product well under that (docs/release/ai-release.md).
# RAG_ANSWERER_TIMEOUT=60
# RAG_ANSWERER_RETRIES=2

# Leave unset unless you have measured otherwise. Empty means each reranker
# supplies the floor that belongs to its own scoring scheme - the lexical
# one and a cross-encoder do not produce comparable numbers.
# RAG_RELEVANCE_FLOOR=

# Share of an answer's content words that must appear in the passages it
# cites, behind grounding's per-figure check. Raising this toward 0.55
# re-creates a filter that rejected well-written answers for using ordinary
# English while passing fluent answers that changed a figure.
# RAG_MIN_SUPPORT_RATIO=0.25

# How many earlier questions may lend vocabulary to a follow-up like "what
# about MECH?" before retrieval runs. 0 restores one-shot questions.
# RAG_FOLLOWUP_HISTORY_TURNS=2

# --- Production (see docker-compose.prod.yml) -------------------------
# NGINX_SERVER_NAME=docs.example.edu
# CSRF_TRUSTED_ORIGINS=https://docs.example.edu
# SECURE_HSTS_SECONDS=31536000      # off by default: close to irreversible
# SECURE_HSTS_PRELOAD=True
# EMAIL_HOST=smtp.example.edu       # console backend until this is set
# GUNICORN_WORKERS=3
# CELERY_CONCURRENCY=4
# METRICS_ALLOWED_IPS=10.0.0.5
# Object storage instead of the media volume. Build with INSTALL_S3=true.
# Unverified against a real bucket (docs/release/multi-host-validation.md).
# INSTALL_S3=true
# AWS_STORAGE_BUCKET_NAME=adi-documents
# AWS_S3_REGION_NAME=
# AWS_S3_ENDPOINT_URL=http://minio:9000   # only for S3-compatible stores
BACKUP_ROOT=./backups
BACKUP_RETENTION=7

# Distributed tracing (spec 20). Off when unset. Requires an image built
# with INSTALL_OTEL=true; locally, `docker compose --profile tracing up -d jaeger`.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
