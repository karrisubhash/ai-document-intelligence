DJANGO_DEBUG=True
# Required when DJANGO_DEBUG is not true - startup fails without it, and
# fails on this placeholder too. Generate a real one for any deployment.
DJANGO_SECRET_KEY=change-me
# Comma-separated hostnames this deployment answers on.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=ai_document_intelligence
POSTGRES_USER=app_user
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

REDIS_HOST=redis
REDIS_PORT=6379

CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

APP_PORT=8000

# --- Text extraction and OCR -------------------------------------------
# Render DPI for OCR of PDF pages. 250 was best on average over real pages;
# very small print reads worse above it, so raising it is not an upgrade.
# OCR_DPI=250
# Seconds the OCR of one document may take before the rest of a long scan
# is read at a lower resolution instead of timing out.
# OCR_TIME_BUDGET_SECONDS=540
# Tesseract language packs joined with +. Installed ones are used, the
# rest dropped, English is the floor. Add packs with the TESSERACT_LANGS
# docker build arg.
# OCR_LANGUAGES=eng
# Words Tesseract is less sure of than this percent are dropped.
# OCR_MIN_WORD_CONFIDENCE=30
# Check a poorly read scan for being sideways/upside down and read it again.
# OCR_DETECT_ROTATION=True
# OCR pictures inside PDF pages, Word files and slides that read like a
# document, up to this many per file.
# OCR_EMBEDDED_IMAGES=True
# OCR_EMBEDDED_IMAGES_MAX=20

# --- Frontend console --------------------------------------------------
# Origins allowed to call this API cross-origin. Empty means same-origin
# only, which is the right production default; in DEBUG the Vite dev
# server's origin is allowed automatically, so this only needs setting
# when the console runs somewhere else.
# CORS_ALLOWED_ORIGINS=http://localhost:5173

# Host port the frontend dev server binds to when run under Docker
# (`docker compose --profile frontend up`).
FRONTEND_PORT=5173

# --- Document classification (optional) -------------------------------
# Empty means the CLASSIFICATION pipeline stage records SKIPPED - it never
# guesses a label. To enable the trained text baseline:
#   1. Train an artifact:  python -m ai.classification.training.train_text
#   2. Build with the ML layer:  INSTALL_ML=true docker compose up --build
#   3. Uncomment the line below.
# The artifact path needs no configuration - docker-compose mounts
# ai/classification/artifacts/ where the setting's default already looks.
# DOCUMENT_CLASSIFIER=documents.processing.classification.text_classifier.TextDocumentClassifier
INSTALL_ML=false

# Bakes the Anthropic SDK and boto3 into the image, which all three
# Bedrock-backed components need. See the Bedrock section below.
#   INSTALL_LLM=true docker compose up --build
INSTALL_LLM=false

# Bakes CPU torch and sentence-transformers into the image, which the local
# embedding provider and cross-encoder reranker need. Set it whenever
# DOCUMENT_EMBEDDING_PROVIDER or RAG_RERANKER names a `local` class: a
# rebuild without it leaves every upload failing at the EMBEDDING stage.
#   INSTALL_LOCAL=true docker compose up --build
INSTALL_LOCAL=false

# --- Structure and planning (phase 12) --------------------------------
# Both detectors default ON and are listed here only to switch them off.
# They are the two pluggable capabilities with nothing to configure: one
# reads tables out of page text that has already been extracted, the other
# reads the image dictionary a PDF already carries. Neither needs a model,
# an artifact or a download.
#
# Setting either to empty makes that half of LAYOUT_ANALYSIS record SKIPPED.
# DOCUMENT_TABLE_DETECTOR=
# DOCUMENT_FIGURE_DETECTOR=
#
# How many parts a multi-part question may be planned into. 1 disables
# planning entirely. Each step is a full retrieval, so this is a bound.
# RAG_MAX_PLAN_STEPS=4

# --- Document intelligence --------------------------------------------
# All defaults are ON and need nothing: CPU only, no LLM, no artifact.
# Listed to tune or switch off. See docs/ai/pipeline.md, "Document
# intelligence".
#
# Institutional type detection (CLASSIFICATION stage). Empty disables it.
# DOCUMENT_TYPE_DETECTOR=documents.processing.classification.institutional.InstitutionalTypeDetector
# DOCUMENT_TYPE_MIN_CONFIDENCE=0.6  # below this it abstains and keeps the type
# DOCUMENT_TYPE_AUTO_APPLY=True     # False: record verdicts as suggestions only
#
# Field extraction now defaults to the bundled rule extractor; empty disables.
# DOCUMENT_FIELD_EXTRACTOR=documents.processing.field_extraction.rule_extractor.RuleFieldExtractor
#
# Post-publish enrichment on the `index` queue: brief, entities, related-
# documents centroid, first-page thumbnail. Backfill existing documents
# with `manage.py build_insights --missing`.
# DOCUMENT_INSIGHTS_ENABLED=True
# DOCUMENT_THUMBNAIL_WIDTH=320
# DOCUMENT_THUMBNAIL_DPI=60
# DOCUMENT_NEAR_DUPLICATE_SIMILARITY=0.97
# DOCUMENT_RELATED_MIN_SIMILARITY=0.5   # semantic neighbours below this are not shown
# DOCUMENT_SUGGESTIONS_CACHE_SECONDS=600
# THROTTLE_INSIGHTS=600/hour         # related, suggestions, deadlines, type changes

# --- Amazon Bedrock: the three real AI components ---------------------
# One AWS account replaces all three bundled baselines. Until these are
# set the platform still works, and still says what it is doing: retrieval
# is lexical-only, and answers are verbatim quotes rather than prose.
#
#   embeddings  hashing baseline (semantic=False)  ->  Titan Text Embeddings V2
#   reranking   lexical word overlap               ->  Cohere Rerank 3.5
#   answering   verbatim sentence extraction       ->  Claude Opus 5
#
# PREREQUISITES, in this order:
#   1. pip install -r backend/requirements-llm.txt   (or INSTALL_LLM=true)
#   2. AWS credentials on the machine. The SDK reads ~/.aws/credentials,
#      an instance role, or AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY from
#      the environment. Do NOT put secrets in this file - it is committed.
#      A console username and password will not work; Bedrock needs an
#      access key, an SSO profile or a role.
#   3. Bedrock console -> Model access -> request access to Anthropic
#      Claude, Amazon Titan Embeddings and Cohere Rerank, IN THE REGION
#      BELOW. Access is per-region, and a model you have not been granted
#      returns a 404 that reads like the model does not exist.
#
# Required for every Bedrock call. No default: a silent us-east-1 would
# send traffic to a region the account may have no model access in.
# AWS_BEDROCK_REGION=us-east-1

# Semantic embeddings. The single highest-impact setting here: the hashing
# baseline treats "car" and "automobile" as orthogonal, which is survivable
# across five documents and is not across twelve thousand.
#
# SWITCHING THIS INVALIDATES EVERY STORED VECTOR. A vector is only
# comparable to another from the same model, so the migration and a full
# re-index are part of the change, not follow-up tidying:
#   1. write that migration first - the repository has none: change
#      EMBEDDING_DIMENSIONS in documents/models/chunk.py to 1024 (or 512/256)
#      and alter the embedding column and its HNSW index to match;
#   2. python manage.py migrate
#   3. python manage.py reindex       # re-embeds every chunk
# As shipped the column is 384 wide, which Titan cannot produce, and the
# Bedrock provider refuses to load until it is migrated.
# DOCUMENT_EMBEDDING_PROVIDER=documents.processing.embedding.bedrock.BedrockTitanEmbeddingProvider
# EMBEDDING_BEDROCK_CONCURRENCY=8     # Titan embeds one text per call

# Cross-encoder reranking. Reads query and passage together, so it scores
# whether a passage ANSWERS the question rather than whether it repeats its
# words - the largest precision gain available once hybrid retrieval exists.
# RAG_RERANKER=documents.rag.bedrock_rerank.BedrockReranker

# Generative answering. The guardrails do not move: permission filter still
# runs first, every claim still needs a resolvable citation, every figure
# is still checked against the passages, and a failure is still downgraded
# to an abstention.
# RAG_ANSWERER=documents.rag.claude.ClaudeAnswerer
# RAG_ANSWERER_BACKEND=bedrock
# RAG_ANSWERER_MODEL=claude-opus-5    # the "anthropic." prefix is added for you
# RAG_ANSWERER_EFFORT=medium
# A hosted answerer runs inside the chat request, and nginx gives up at 120 s.
# TIMEOUT is per attempt; DEADLINE is the most ONE walk of the provider chain may
# take, so a hung provider cannot outlast the proxy (each attempt is given what is
# left of it; 0 turns the limit off). A corrective retry is a second walk, so keep
# twice DEADLINE well under 120 (docs/release/ai-release.md).
# RAG_ANSWERER_TIMEOUT=60
# RAG_ANSWERER_RETRIES=2
# RAG_ANSWERER_DEADLINE=50

# Leave unset unless you have measured otherwise. Empty means each reranker
# supplies the floor that belongs to its own scoring scheme - the lexical
# one and a cross-encoder do not produce comparable numbers.
# RAG_RELEVANCE_FLOOR=

# Share of an answer's content words that must appear in the passages it
# cites, behind grounding's per-figure check. Raising this toward 0.55
# re-creates a filter that rejected well-written answers for using ordinary
# English while passing fluent answers that changed a figure.
# RAG_MIN_SUPPORT_RATIO=0.25

# How many earlier questions may lend vocabulary to a follow-up like "what
# about MECH?" before retrieval runs. 0 restores one-shot questions.
# RAG_FOLLOWUP_HISTORY_TURNS=2

# --- Self-service sign-up ---------------------------------------------
# Anyone may ASK for an account from the sign-in page; an administrator
# approves each request (docs/release/institutional-decisions.md, I7).
# False: administrators issue every account and the page stops offering it.
# SIGNUP_ENABLED=True
# SIGNUP_MAX_PENDING=500            # stop taking requests with this many waiting
# THROTTLE_SIGNUP=100/hour          # attempts per address (a campus NAT is one)
# SIGNUP_EMAIL_DOMAINS=example.edu  # only these domains (and subdomains); empty: any

# --- Notifications (the bell; docs/architecture/notifications.md) ------
# Batch results fold into one notification while each arrives within this
# many minutes of the last (0: one per document).
# NOTIFICATIONS_COALESCE_MINUTES=10
# prune_notifications (cron, daily) deletes read ones older than this, and
# unread ones older than the second; 0 keeps that kind forever.
# NOTIFICATIONS_RETENTION_DAYS=30
# NOTIFICATIONS_UNREAD_RETENTION_DAYS=180
# NOTIFICATIONS_ATTENTION_CACHE_SECONDS=30   # administrators' sidebar counts
# THROTTLE_NOTIFICATIONS=1200/hour           # bell + badge polling per person
# --- Analytics (docs/operations/analytics.md) ---------------------------
# Where a "day" starts for every daily chart; an IANA name. Stored times stay
# UTC whatever this says. Defaults to TIME_ZONE (UTC).
# ANALYTICS_TIME_ZONE=Asia/Kolkata
# ANALYTICS_CACHE_SECONDS=300            # one report per department and range
# DASHBOARD_ACTIVITY_CACHE_SECONDS=60    # the home screen's trends, per user
# THROTTLE_ANALYTICS_REFRESH=60/hour     # the page's Refresh, per administrator
# --- One-click demo ---------------------------------------------------
# "Try the live demo" on the landing page: each visitor gets an ephemeral,
# read-only guest account in DEMO_DEPARTMENT (docs/security/model.md).
# Fill the department first (manage.py seed_demo) and schedule
# manage.py purge_demo_guests (docs/deployment/production.md). Turned off,
# guests already signed in are signed out on their next request;
# purge_demo_guests --all deletes them all at once.
# Keep THROTTLE_DEMO_GLOBAL x DEMO_GUEST_TTL_HOURS within DEMO_MAX_GUESTS
# (60/hour x 3 h = 180 of 200), or the demo can be filled and held full;
# manage.py check warns when it is not.
# DEMO_ENABLED=False
# DEMO_DEPARTMENT=Demo
# DEMO_GUEST_TTL_HOURS=3            # guests (and their conversations) deleted after this
# DEMO_GUEST_IDLE_MINUTES=30        # at the ceiling, a guest idle this long makes way
# DEMO_MAX_GUESTS=200               # guest accounts existing at once
# THROTTLE_DEMO=10/hour             # demo starts per address
# THROTTLE_DEMO_GLOBAL=60/hour      # demo starts from all addresses together
# THROTTLE_GUEST_CHAT=20/hour       # questions per guest (on top of THROTTLE_CHAT)
# THROTTLE_GUEST_CHAT_BURST=5/minute
# THROTTLE_GUEST_CHAT_GLOBAL=120/hour  # questions from all guests together
# THROTTLE_GUEST_SEARCH=60/hour
# THROTTLE_GUEST_SEARCH_GLOBAL=600/hour
# THROTTLE_SAMPLES=10/hour          # POST /api/v1/admin/samples/ per administrator

# --- Production (see docker-compose.prod.yml) -------------------------
# NGINX_SERVER_NAME=docs.example.edu
# CSRF_TRUSTED_ORIGINS=https://docs.example.edu
# SECURE_HSTS_SECONDS=31536000      # off by default: close to irreversible
# SECURE_HSTS_PRELOAD=True
# EMAIL_HOST=smtp.example.edu       # console backend until this is set
# Process sizes. docker-compose.small.yml sets these for a 2 vCPU / 8 GB
# server (docs/deployment/production.md#small-server-profile); any set here
# wins over either compose file's default.
# GUNICORN_WORKERS=3
# GUNICORN_THREADS=2
# CELERY_CONCURRENCY=2
# CELERY_INDEX_CONCURRENCY=6
# EMBEDDING_LOCAL_THREADS=1         # torch threads per process; 0 = one per host core
# METRICS_ALLOWED_IPS=10.0.0.5
# Object storage instead of the media volume. Build with INSTALL_S3=true.
# Unverified against a real bucket (docs/release/multi-host-validation.md).
# INSTALL_S3=true
# AWS_STORAGE_BUCKET_NAME=adi-documents
# AWS_S3_REGION_NAME=
# AWS_S3_ENDPOINT_URL=http://minio:9000   # only for S3-compatible stores
BACKUP_ROOT=./backups
BACKUP_RETENTION=7

# Distributed tracing (spec 20). Off when unset. Requires an image built
# with INSTALL_OTEL=true; locally, `docker compose --profile tracing up -d jaeger`.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318

# --- ChatGPT-style chat on a free model -------------------------------------
# Gemini Flash writes the answers (streamed word by word), and questions your
# documents do not cover - including greetings - get a general-knowledge
# reply labelled "not from your documents".
#   1. Get a free key: https://aistudio.google.com/apikey
#   2. Uncomment the four lines below and paste the key.
#   3. Rebuild with INSTALL_LLM=true (the OpenAI-compatible client).
# Free tier: Google may use what is sent to improve its products. Attach
# billing to the key to stop that before using confidential documents.
# RAG_ANSWERER=documents.rag.openai_compat.OpenAICompatibleAnswerer
# RAG_ANSWERER_PROVIDER=gemini
# GEMINI_API_KEY=
# CHAT_GENERAL_KNOWLEDGE=True
# COST of general knowledge: a question your documents cannot answer then takes
# up to TWO model calls - first a grounded attempt that is shown the best
# passages (a correct paraphrase scores no higher than an unrelated question,
# so only the model can tell them apart) and answers "not found", then the
# general reply. The first call sends the provider up to 14,000 characters of
# your documents and spends one of its daily requests. On a tight daily budget
# set RAG_MODEL_JUDGES_RELEVANCE=False (below): one call, but the old floor.

# --- More written answers a day: a chain across free providers ------------
# Gemini's free tier is ~20 requests per model per day. Add other providers'
# free keys and list them after Gemini; each link adds its own allowance, and
# a link without a key is skipped. Details, limits and data-use terms:
# docs/ai/llm-providers.md
# The chain that needs no payment card at any of its three links (checked
# against each provider's own documentation, 2026-11-15; Groq's free-plan
# limits are not on its docs pages, so its numbers are unverified):
# RAG_ANSWERER_CHAIN=gemini,groq,openrouter
# Groq's free tier is 8K tokens a MINUTE: about one grounded question a minute
# and ~30 a day, and no corrective retry fits in the same minute. On a busy
# site put openrouter before groq, or groq last.
# CEREBRAS_API_KEY and GITHUB_MODELS_TOKEN are NOT in the recommended chain:
# Cerebras needs a verified payment method before its API turns on (a one-time
# $5 credit, expires after 30 days, not intended for production), and GitHub
# Models was RETIRED on 30 July 2026, so the `github` preset no longer works.
# Keep one key per provider for ONE site: rotating several accounts' keys to
# multiply the free quota is against Google's API terms (Google APIs Terms of
# Service, section 2(d)), and Gemini limits are per project, not per key.
# GROQ_API_KEY=                     # console.groq.com/keys
# OPENROUTER_API_KEY=               # openrouter.ai/keys (free models may train on input)
# CEREBRAS_API_KEY=                 # cloud.cerebras.ai (needs a payment method)
# MISTRAL_API_KEY=                  # console.mistral.ai (free plan may train on input)
# GITHUB_MODELS_TOKEN=              # retired 2026-07-30: leave unset
# Requests per model per day each link may make, over the presets' defaults
# (gemini 20, groq 30, cerebras 100, mistral 100, github 50 [retired],
# openrouter 50); provider, provider:model or * as the key, 0 = no limit
# enforced.
# LLM_DAILY_LIMITS=groq=200
# Calls a day kept for chat: document briefs stop at this many left, grids at
# twice it, other background AI at three times it.
# LLM_CHAT_RESERVE=20
# THROTTLE_AI_TEST=10/hour          # System status "Test" button, per admin
# RAG_ANSWERER_REASONING_EFFORT: empty keeps each preset's own value (gemini
# sends "none", groq and cerebras send "low"). In a chain ONE value is offered to
# all three, and each takes it only if its preset documents it ("none" is
# Gemini's, "low"/"medium"/"high" are gpt-oss's); one that does not keeps its
# own value and logs llm.effort_not_sent. "default" sends nothing to any link.

# --- Answer quality while a model writes the answer (all optional) ---------
# These apply ONLY while a generative model can answer now; a quote (the
# extractive answerer, or the fallback when no model is available) keeps the
# relevance floor and the smaller context it was measured with.
# THE ON/OFF SWITCHES BELOW MUST BE WRITTEN EXACTLY True OR False
# (RAG_MODEL_JUDGES_RELEVANCE, RAG_GROUNDING_RETRY, RAG_PLAN_WHEN_GENERATIVE).
# Anything else - an empty value, 1, yes, on, or a trailing space - reads as
# False, silently turning a default-ON feature off.
# The model, not the reranker's score floor, judges whether a passage answers
# the question: the reranker's top RAG_MIN_PASSAGES and retrieval's top
# RAG_ADMIT_RETRIEVAL_TOP go to it even below the floor. False restores the floor.
# RAG_MODEL_JUDGES_RELEVANCE=True
# RAG_MIN_PASSAGES=6
# RAG_ADMIT_RETRIEVAL_TOP=2
# What it is shown: characters and passages, and how many of the best passages
# get the chunks either side of them added.
# RAG_CONTEXT_BUDGET_GENERATIVE=14000
# RAG_MAX_PASSAGES_GENERATIVE=12
# RAG_NEIGHBOUR_ANCHORS=3
# An answer rejected only for stating figures its passages lack is sent back to
# the model once, told which figures, before it is discarded.
# RAG_GROUNDING_RETRY=True
# A compound question goes to a model whole; True plans it into parts anyway.
# RAG_PLAN_WHEN_GENERATIVE=False
