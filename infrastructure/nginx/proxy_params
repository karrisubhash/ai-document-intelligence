proxy_pass http://backend;
proxy_http_version 1.1;

proxy_set_header Host              $host;
proxy_set_header X-Real-IP         $remote_addr;
proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
# The pair that makes SECURE_PROXY_SSL_HEADER work. Without it Django sees
# plain HTTP on the internal hop and SECURE_SSL_REDIRECT loops forever.
proxy_set_header X-Forwarded-Proto $scheme;
# Generated by the observability middleware when absent, so a trace id
# exists even for requests that arrive without one.
proxy_set_header X-Request-ID      $request_id;

proxy_redirect off;
# Buffering ON (nginx's default). With it off, nginx read from gunicorn only
# as fast as the CLIENT accepted bytes, so a 50 MB download to a slow phone
# held one of the backend's six request threads for the whole transfer -
# gunicorn's own deployment guide requires a buffering proxy for exactly
# this. Nothing here streams; an endpoint that ever does can opt out per
# response with X-Accel-Buffering: no.
